{
  "name": "delos-cash",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env-dev --env-file-if-exists=.env --import tsx task-dev.ts",
    "build": "node --env-file-if-exists=.env-dev --env-file-if-exists=.env --import tsx task-prod.ts",
    "start": "node --env-file-if-exists=.env-prod --import tsx prod-server.ts",
    "test": "node --env-file-if-exists=.env-test --import tsx --test api/*.test.js web/lib/*.test.js",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "fmt": "prettier --write \"{api,web,migrations}/**/*.{ts,tsx,js}\" *.ts",
    "icons": "node --import tsx task-icons.ts",
    "seed-files": "node --import tsx task-seed-files.ts",
    "backup": "node --env-file-if-exists=.env-dev --env-file-if-exists=.env --import tsx task-backup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.9.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
