APP_ENV=prod
PORT=8000
# URL path prefix under which the app is served; "/" serves it at the root
BASE_URL=/
DATABASE_PATH=/app/data/delos.db
# mock: local simulator with the same states as Bitnob (no network)
# sandbox: real Bitnob sandbox API, needs the keys below (no real money)
BITNOB_MODE=mock
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
BITNOB_BASE_URL=https://api.bitnob.com
# public HTTPS URL of this server, for the Bitnob webhooks (Cloudflare Tunnel…)
PUBLIC_URL=https://delos.example
# guided demo: account switcher, reset, failure states
DEMO_ACCESS=1
# e-mails (Resend): confirmation, password reset, invitations. Empty: no
# e-mail, the demo shows the links on screen; without DEMO_ACCESS, no signup
RESEND_API_KEY=
# a sender on a domain verified at Resend (onboarding@resend.dev only
# delivers to the owner of the Resend account)
RESEND_FROM="DELOS CASH <noreply@delos.example>"
# moderators of a real instance (comma-separated): moderation once confirmed
MODERATOR_EMAILS=
# documents and backups: next to the database by default (the Docker volume)
# FILES_DIR=/app/data/files
# BACKUP_DIR=/app/data/backups
# BACKUP_HOURS=24
# BACKUPS_KEPT=14
